secrets/

# Frozen data ignored until explicit release (keep README + .gitkeep)
data/frozen/**/*
!data/frozen/README.md
!data/frozen/.gitkeep

data/examples/**/*
!data/examples/README.md
!data/examples/.gitkeep

results/summaries/*
!results/summaries/
!results/summaries/README.md
!results/summaries/.gitkeep
results/tables/*
!results/tables/
!results/tables/README.md
!results/tables/.gitkeep
results/figures/*
!results/figures/
!results/figures/README.md
!results/figures/.gitkeep

